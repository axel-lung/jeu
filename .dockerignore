# Le Dockerfile copie explicitement ce dont il a besoin ; ceci garde le contexte
# de build léger et évite qu'un dist/ ou un node_modules local ne s'y glisse.
node_modules
dist
.git
.gitignore
.claude
README.md
Dockerfile
.dockerignore
docker-compose.yml
volumes
*.log

# Empaquetage mobile : les projets natifs et leurs sources d'icônes ne servent
# qu'à fabriquer les apps des stores, jamais à faire tourner le serveur.
android
ios
resources
scripts
capacitor.config.ts
.env.example
