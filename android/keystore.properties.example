# Copiez ce fichier en `android/keystore.properties` et renseignez vos valeurs.
# Ce fichier-ci est un exemple versionné ; `keystore.properties` et les .keystore
# sont ignorés par git — la clé ne doit jamais quitter votre machine.
#
# Créer la clé (une seule fois, à sauvegarder très précieusement) :
#   keytool -genkey -v -keystore android/nations-defense.keystore \
#     -alias nations -keyalg RSA -keysize 2048 -validity 10000

# Chemin du keystore, relatif au dossier android/.
storeFile=nations-defense.keystore
storePassword=votre-mot-de-passe
keyAlias=nations
keyPassword=votre-mot-de-passe
